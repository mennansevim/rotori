{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd rotori-website && python3 -m http.server 5199 --bind 127.0.0.1"
      ],
      "port": 5199,
      "url": "http://127.0.0.1:5199",
      "autoPort": false
    },
    {
      "name": "planner",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:planner"
      ],
      "port": 5174,
      "url": "http://localhost:5174/planner/?u=demo",
      "autoPort": false
    },
    {
      "name": "viewer",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:viewer"
      ],
      "port": 5180,
      "url": "http://localhost:5180/viewer/?u=demo",
      "autoPort": true
    },
    {
      "name": "flutter-preview",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd rotori-mobile && flutter run -d web-server --release --web-hostname 127.0.0.1 --web-port 8092 -t lib/preview_main.dart"
      ],
      "port": 8092,
      "url": "http://127.0.0.1:8092/",
      "autoPort": false
    },
    {
      "name": "flutter-real",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd rotori-mobile && flutter run -d web-server --web-hostname 127.0.0.1 --web-port 8093 -t lib/main.dart --dart-define-from-file=env.json"
      ],
      "port": 8093,
      "url": "http://127.0.0.1:8093/",
      "autoPort": false
    },
    {
      "name": "social-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd rotori-social && .venv/bin/uvicorn src.web.app:app --host 127.0.0.1 --port 8010"
      ],
      "port": 8010,
      "url": "http://127.0.0.1:8010/",
      "autoPort": false
    }
  ]
}
