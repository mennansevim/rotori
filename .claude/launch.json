{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "planner",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:planner"],
      "port": 5174,
      "url": "http://localhost:5174/planner/?u=demo",
      "autoPort": false
    },
    {
      "name": "viewer",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:viewer"],
      "port": 5180,
      "url": "http://localhost:5180/viewer/?u=demo",
      "autoPort": true
    },
    {
      "name": "flutter-preview",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd mobile && flutter run -d web-server --web-hostname 127.0.0.1 --web-port 8091 -t lib/preview_main.dart"
      ],
      "port": 8091,
      "url": "http://127.0.0.1:8091/",
      "autoPort": false
    },
    {
      "name": "flutter-real",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd mobile && flutter run -d web-server --web-hostname 127.0.0.1 --web-port 8093 -t lib/main.dart --dart-define-from-file=env.json"
      ],
      "port": 8093,
      "url": "http://127.0.0.1:8093/",
      "autoPort": false
    }
  ]
}
