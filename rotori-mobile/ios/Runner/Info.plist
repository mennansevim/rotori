<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Rotori</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Rotori</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Gezdiğiniz yerleri otomatik keşfetmek ve rozet kazanmanız için konumunuz kullanılır.</string>
	<!-- iOS 14+: kullanıcı "Yaklaşık Konum" verdiyse, keşif damgası anında
	     GEÇİCİ tam doğruluk isteriz. Apple'ın önerdiği yol budur; "Always"
	     izni istemeyiz ve arka planda konum toplamayız. -->
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>DiscoveryStamp</key>
		<string>Bulunduğunuz noktayı doğrulayıp keşif damgasını verebilmek için bu sırada kesin konum gerekir. İzin geçicidir.</string>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Rotori, bilet fotoğrafını çekmek ve mağaza fiyatlarını algılayıp seçtiğiniz para birimine çevirmek için kameraya erişir. Görüntüler cihazınızda işlenir, yüklenmez.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Bilet görselini galeriden seçmek için erişim gerekir.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- iOS 9+ canLaunchUrl() sadece Info.plist'te beyan edilen scheme'ler
	     için true döner. Google Maps app'i açabilmek için comgooglemaps
	     scheme'i whitelist'e ekli. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
	</array>
	<!-- OAuth (Google, başka provider'lar) deep link callback’ı buradan gelir:
	     io.supabase.rotori://login-callback/ — Supabase Auth tarafı yönlendirir. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>io.supabase.rotori</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>io.supabase.rotori</string>
			</array>
		</dict>
	</array>
	<!-- App Store submit sırasında "Uses non-exempt encryption?" sorusunu
	     otomatik hayır olarak cevaplar. Sadece HTTPS/Supabase gibi standart
	     TLS kullanıyoruz; export compliance beyanı gerekmez. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
