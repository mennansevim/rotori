# Flutter'a --dart-define ile geçirilir; dosya olarak kullanılmaz.
# Değerleri Supabase Dashboard → Project Settings → API'den kopyala.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...  # anon public key (service_role DEĞİL)

# Sentry Flutter projesindeki public DSN. Boşsa crash/performance takibi no-op.
SENTRY_DSN=https://PUBLIC_KEY@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
